# Copy this file to ".env" (same folder as pom.xml) and fill in your own values.
# Real OS environment variables override values in .env.

# Application
APP_NAME=MetroPulse
# development | production   (production refuses to start with placeholder passwords)
APP_ENV=development
APP_PORT=8080

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=metropulse
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_LOCAL

# Administrator account created on first start if it does not exist yet
ADMIN_EMAIL=admin@metropulse.local
ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOYMENT
ADMIN_DISPLAY_NAME=MetroPulse Admin

# true = seed clearly labelled demonstration crowd reports, alerts and facilities
DEMO_DATA_ENABLED=true

# Optional future integrations (leave empty - the app works without them)
MAPS_API_KEY=
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
